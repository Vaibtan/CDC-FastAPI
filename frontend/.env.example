# Backend API base URL (used client-side via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL (used client-side for live event streaming)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Prometheus endpoints (server-side only — used by /api/metrics proxy route)
PROMETHEUS_INGESTOR_URL=http://localhost:9090/metrics
PROMETHEUS_CONTROL_URL=http://localhost:9091/metrics
PROMETHEUS_REPLAYER_URL=http://localhost:9092/metrics

# Metrics configuration
METRICS_REFRESH_INTERVAL_MS=10000
METRICS_HISTORY_POINTS=30
